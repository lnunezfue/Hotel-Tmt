# Base de datos (docker compose levanta MySQL 8 con estos datos)
DATABASE_URL="mysql://hotel:hotel_dev_pass@localhost:3306/hotel_dev"
REDIS_URL="redis://localhost:6379"
# Secretos: cambiar en cada entorno. Nunca se exponen al navegador (RNF-14).
JWT_SECRET="cambia-esto-por-un-secreto-largo"
# Obligatoria con NODE_ENV=production (la API no arranca sin ella)
# Minutos de vida del token de acceso
JWT_ACCESO_MIN=15
# Duración máxima de una sesión, en horas
SESION_MAX_HORAS=12
# Tolerancia (segundos) para reusar un token de renovación recién rotado
REFRESH_GRACIA_SEG=30
# false por defecto; 1 detrás de Nginx/Caddy
TRUST_PROXY=false
# Límite por IP en login y renovación (peticiones por minuto)
LIMITE_AUTH_POR_MIN=10
PORT=3000
# BETA | PRODUCCION. Debe coincidir con empresa.sunat_entorno (sección 5.2 del DT-001)
SUNAT_ENTORNO="BETA"
# simulado | nubefact | factusmart
PSE_PROVEEDOR="simulado"
