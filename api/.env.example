# Base de datos (docker compose levanta MySQL 8 con estos datos)
DATABASE_URL="mysql://hotel:hotel_dev_pass@localhost:3306/hotel_dev"
REDIS_URL="redis://localhost:6379"
# Secretos: cambiar en cada entorno. Nunca se exponen al navegador (RNF-14).
JWT_SECRET="cambia-esto-por-un-secreto-largo"
JWT_EXPIRES_IN="8h"
PORT=3000
# BETA | PRODUCCION. Debe coincidir con empresa.sunat_entorno (sección 5.2 del DT-001)
SUNAT_ENTORNO="BETA"
# simulado | nubefact | factusmart
PSE_PROVEEDOR="simulado"
