// Generado desde la base de datos con scripts/gen-prisma-schema.py (equivalente a `prisma db pull`).
// Las reglas que Prisma no modela (CHECK, triggers, procedimientos, vistas, columnas generadas)
// viven en las migraciones SQL de prisma/migrations. No edites el esquema a mano: cambia la BD con una migración
// y vuelve a generar este archivo.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model auditoria {
  id            BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  usuario_id    Int?             @db.UnsignedInt
  tabla         String           @db.VarChar(64)
  registro_id   BigInt           @db.UnsignedBigInt
  accion        auditoria_accion
  datos_antes   Json?
  datos_despues Json?
  ip            String?          @db.VarChar(45)
  created_at    DateTime         @default(now()) @db.Timestamp(0)
  usuario       usuario?         @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_aud_usuario")

  @@index([usuario_id], map: "fk_aud_usuario")
  @@index([created_at], map: "ix_aud_fecha")
  @@index([tabla, registro_id], map: "ix_aud_tabla_reg")
}

model caja {
  id          Int           @id @default(autoincrement()) @db.UnsignedInt
  sucursal_id Int           @db.UnsignedInt
  nombre      String        @db.VarChar(60)
  activo      Boolean       @default(true) @db.TinyInt
  sucursal    sucursal      @relation(fields: [sucursal_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_caja_sucursal")
  caja_sesion caja_sesion[]

  @@unique([sucursal_id, nombre], map: "uk_caja")
}

model caja_movimiento {
  id                     BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  caja_sesion_id         BigInt              @db.UnsignedBigInt
  concepto_movimiento_id Int                 @db.UnsignedSmallInt
  metodo_pago_id         Int                 @db.UnsignedTinyInt
  monto                  Decimal             @db.Decimal(14, 2)
  comprobante_pago_id    BigInt?             @db.UnsignedBigInt
  reserva_id             BigInt?             @db.UnsignedBigInt
  descripcion            String?             @db.VarChar(250)
  usuario_id             Int                 @db.UnsignedInt
  fecha_hora             DateTime            @default(now()) @db.DateTime(0)
  concepto_movimiento    concepto_movimiento @relation(fields: [concepto_movimiento_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cm_concepto")
  comprobante_pago       comprobante_pago?   @relation(fields: [comprobante_pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cm_cpago")
  metodo_pago            metodo_pago         @relation(fields: [metodo_pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cm_metodo")
  reserva                reserva?            @relation(fields: [reserva_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cm_reserva")
  caja_sesion            caja_sesion         @relation(fields: [caja_sesion_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cm_sesion")
  usuario                usuario             @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cm_usuario")

  @@index([usuario_id], map: "fk_cm_usuario")
  @@index([concepto_movimiento_id], map: "ix_cm_concepto")
  @@index([comprobante_pago_id], map: "ix_cm_cpago")
  @@index([metodo_pago_id], map: "ix_cm_metodo")
  @@index([reserva_id], map: "ix_cm_reserva")
  @@index([caja_sesion_id, fecha_hora], map: "ix_cm_sesion")
}

model caja_sesion {
  id                     BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  caja_id                Int                @db.UnsignedInt
  usuario_id             Int                @db.UnsignedInt
  fecha_apertura         DateTime           @default(now()) @db.DateTime(0)
  monto_apertura         Decimal            @default(0.00) @db.Decimal(14, 2)
  fecha_cierre           DateTime?          @db.DateTime(0)
  monto_cierre_sistema   Decimal?           @db.Decimal(14, 2)
  monto_cierre_declarado Decimal?           @db.Decimal(14, 2)
  diferencia             Decimal?           @db.Decimal(14, 2) /// columna generada por la BD (solo lectura)
  estado                 caja_sesion_estado @default(ABIERTA)
  observaciones          String?            @db.VarChar(500)
  caja_abierta           Int?               @unique(map: "uk_cs_una_abierta") @db.UnsignedInt /// columna generada por la BD (solo lectura)
  caja                   caja               @relation(fields: [caja_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cs_caja")
  usuario                usuario            @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cs_usuario")
  caja_movimiento        caja_movimiento[]
  comprobante            comprobante[]

  @@index([caja_id, fecha_apertura], map: "ix_cs_caja_fecha")
  @@index([usuario_id, fecha_apertura], map: "ix_cs_usuario")
}

model canal_venta {
  id                  Int        @id @default(autoincrement()) @db.UnsignedSmallInt
  empresa_id          Int        @db.UnsignedInt
  nombre              String     @db.VarChar(60)
  comision_porcentaje Decimal    @default(0.00) @db.Decimal(5, 2)
  es_ota              Boolean    @default(false) @db.TinyInt
  activo              Boolean    @default(true) @db.TinyInt
  empresa             empresa    @relation(fields: [empresa_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_canal_empresa")
  estancia            estancia[]
  reserva             reserva[]
  tarifa              tarifa[]

  @@unique([empresa_id, nombre], map: "uk_canal_nombre")
}

model categoria_producto {
  id         Int        @id @default(autoincrement()) @db.UnsignedSmallInt
  empresa_id Int        @db.UnsignedInt
  nombre     String     @db.VarChar(80)
  activo     Boolean    @default(true) @db.TinyInt
  empresa    empresa    @relation(fields: [empresa_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catprod_empresa")
  producto   producto[]

  @@unique([empresa_id, nombre], map: "uk_catprod")
}

model certificado_digital {
  id                Int      @id @default(autoincrement()) @db.UnsignedInt
  empresa_id        Int      @db.UnsignedInt
  alias             String   @db.VarChar(80)
  archivo_ruta      String   @db.VarChar(255)
  clave_cifrada     Bytes    @db.VarBinary(255)
  numero_serie      String?  @db.VarChar(64)
  emisor            String?  @db.VarChar(200)
  fecha_emision     DateTime @db.Date
  fecha_vencimiento DateTime @db.Date
  es_vigente        Boolean  @default(true) @db.TinyInt
  created_at        DateTime @default(now()) @db.Timestamp(0)
  updated_at        DateTime @default(now()) @db.Timestamp(0)
  empresa           empresa  @relation(fields: [empresa_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cert_empresa")

  @@index([empresa_id, es_vigente, fecha_vencimiento], map: "ix_cert_empresa_vig")
}

model cliente {
  id                BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  empresa_id        Int                      @db.UnsignedInt
  tipo_documento_id Int                      @db.UnsignedTinyInt
  numero_documento  String                   @db.VarChar(15)
  razon_social      String?                  @db.VarChar(200)
  nombres           String?                  @db.VarChar(100)
  apellidos         String?                  @db.VarChar(100)
  nombre_completo   String?                  @db.VarChar(250) /// columna generada por la BD (solo lectura)
  direccion         String?                  @db.VarChar(250)
  pais_codigo       String                   @default("PE") @db.Char(2)
  fecha_nacimiento  DateTime?                @db.Date
  sexo              cliente_sexo?
  telefono          String?                  @db.VarChar(20)
  email             String?                  @db.VarChar(120)
  observaciones     String?                  @db.VarChar(500)
  activo            Boolean                  @default(true) @db.TinyInt
  created_at        DateTime                 @default(now()) @db.Timestamp(0)
  updated_at        DateTime                 @default(now()) @db.Timestamp(0)
  empresa           empresa                  @relation(fields: [empresa_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cliente_empresa")
  pais              pais                     @relation(fields: [pais_codigo], references: [codigo], onDelete: NoAction, onUpdate: NoAction, map: "fk_cliente_pais")
  tipo_documento    tipo_documento_identidad @relation(fields: [tipo_documento_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cliente_tdi")
  comprobante       comprobante[]
  estancia_huesped  estancia_huesped[]
  reserva           reserva[]

  @@unique([empresa_id, tipo_documento_id, numero_documento], map: "uk_cliente_doc")
  @@index([nombre_completo], map: "ix_cliente_nombre")
  @@index([pais_codigo], map: "ix_cliente_pais")
  @@index([tipo_documento_id], map: "ix_cliente_tdi")
}

model compra {
  id                  BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  sucursal_id         Int              @db.UnsignedInt
  proveedor_id        Int              @db.UnsignedInt
  tipo_comprobante_id Int              @db.UnsignedTinyInt
  serie               String           @db.VarChar(4)
  numero              String           @db.VarChar(10)
  fecha_emision       DateTime         @db.Date
  fecha_registro      DateTime         @default(now()) @db.DateTime(0)
  moneda_id           Int              @db.UnsignedTinyInt
  tipo_cambio         Decimal          @default(1.0000) @db.Decimal(10, 4)
  subtotal            Decimal          @default(0.00) @db.Decimal(14, 2)
  igv                 Decimal          @default(0.00) @db.Decimal(14, 2)
  total               Decimal          @default(0.00) @db.Decimal(14, 2)
  guia_remision       String?          @db.VarChar(20)
  estado              compra_estado    @default(REGISTRADA)
  observaciones       String?          @db.VarChar(500)
  usuario_id          Int              @db.UnsignedInt
  created_at          DateTime         @default(now()) @db.Timestamp(0)
  updated_at          DateTime         @default(now()) @db.Timestamp(0)
  moneda              moneda           @relation(fields: [moneda_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_compra_moneda")
  proveedor           proveedor        @relation(fields: [proveedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_compra_proveedor")
  sucursal            sucursal         @relation(fields: [sucursal_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_compra_sucursal")
  tipo_comprobante    tipo_comprobante @relation(fields: [tipo_comprobante_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_compra_tcomp")
  usuario             usuario          @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_compra_usuario")
  compra_detalle      compra_detalle[]

  @@unique([proveedor_id, tipo_comprobante_id, serie, numero], map: "uk_compra_doc")
  @@index([moneda_id], map: "fk_compra_moneda")
  @@index([usuario_id], map: "fk_compra_usuario")
  @@index([sucursal_id, fecha_emision], map: "ix_compra_fecha")
  @@index([tipo_comprobante_id], map: "ix_compra_tcomp")
}

model compra_detalle {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  compra_id             BigInt                  @db.UnsignedBigInt
  producto_id           Int                     @db.UnsignedInt
  cantidad              Decimal                 @db.Decimal(12, 3)
  costo_unitario        Decimal                 @db.Decimal(14, 4)
  igv                   Decimal                 @default(0.00) @db.Decimal(14, 2)
  subtotal              Decimal                 @db.Decimal(14, 2)
  compra                compra                  @relation(fields: [compra_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cd_compra")
  producto              producto                @relation(fields: [producto_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cd_producto")
  movimiento_inventario movimiento_inventario[]

  @@index([compra_id], map: "ix_cd_compra")
  @@index([producto_id], map: "ix_cd_producto")
}

model comprobante {
  id                                     BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  sucursal_id                            Int                      @db.UnsignedInt
  serie_id                               Int                      @db.UnsignedInt
  tipo_comprobante_id                    Int                      @db.UnsignedTinyInt
  serie                                  String                   @db.Char(4)
  numero                                 Int                      @db.UnsignedInt
  fecha_emision                          DateTime                 @db.Date
  hora_emision                           DateTime                 @db.Time(0)
  fecha_vencimiento                      DateTime?                @db.Date
  forma_pago                             comprobante_forma_pago   @default(CONTADO)
  cliente_id                             BigInt                   @db.UnsignedBigInt
  cliente_tipo_doc                       String                   @db.Char(1)
  cliente_num_doc                        String                   @db.VarChar(15)
  cliente_nombre                         String                   @db.VarChar(250)
  cliente_direccion                      String?                  @db.VarChar(250)
  moneda_id                              Int                      @db.UnsignedTinyInt
  tipo_cambio                            Decimal                  @default(1.0000) @db.Decimal(10, 4)
  estancia_id                            BigInt?                  @db.UnsignedBigInt
  reserva_id                             BigInt?                  @db.UnsignedBigInt
  caja_sesion_id                         BigInt?                  @db.UnsignedBigInt
  descuento_id                           Int?                     @db.UnsignedInt
  comprobante_ref_id                     BigInt?                  @db.UnsignedBigInt
  motivo_nota_id                         Int?                     @db.UnsignedTinyInt
  sustento_nota                          String?                  @db.VarChar(250)
  total_gravada                          Decimal                  @default(0.00) @db.Decimal(14, 2)
  total_exonerada                        Decimal                  @default(0.00) @db.Decimal(14, 2)
  total_inafecta                         Decimal                  @default(0.00) @db.Decimal(14, 2)
  total_gratuita                         Decimal                  @default(0.00) @db.Decimal(14, 2)
  descuento_global                       Decimal                  @default(0.00) @db.Decimal(14, 2)
  total_igv                              Decimal                  @default(0.00) @db.Decimal(14, 2)
  total_icbper                           Decimal                  @default(0.00) @db.Decimal(14, 2)
  total                                  Decimal                  @default(0.00) @db.Decimal(14, 2)
  monto_letras                           String?                  @db.VarChar(250)
  estado_sunat                           comprobante_estado_sunat @default(PENDIENTE)
  hash_cpe                               String?                  @db.VarChar(100)
  xml_nombre                             String?                  @db.VarChar(100)
  xml_ruta                               String?                  @db.VarChar(255)
  cdr_ruta                               String?                  @db.VarChar(255)
  cdr_codigo                             String?                  @db.VarChar(10)
  cdr_descripcion                        String?                  @db.VarChar(500)
  fecha_envio_sunat                      DateTime?                @db.DateTime(0)
  observaciones                          String?                  @db.VarChar(500)
  usuario_id                             Int                      @db.UnsignedInt
  created_at                             DateTime                 @default(now()) @db.Timestamp(0)
  updated_at                             DateTime                 @default(now()) @db.Timestamp(0)
  caja_sesion                            caja_sesion?             @relation(fields: [caja_sesion_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comp_caja")
  cliente                                cliente                  @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comp_cliente")
  descuento                              descuento?               @relation(fields: [descuento_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comp_desc")
  estancia                               estancia?                @relation(fields: [estancia_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comp_estancia")
  moneda                                 moneda                   @relation(fields: [moneda_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comp_moneda")
  motivo_nota                            motivo_nota?             @relation(fields: [motivo_nota_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comp_motivo")
  comprobante_ref                        comprobante?             @relation("comprobante_comprobante_ref_id", fields: [comprobante_ref_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comp_ref")
  reserva                                reserva?                 @relation(fields: [reserva_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comp_reserva")
  serie_ref                              serie                    @relation(fields: [serie_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comp_serie")
  sucursal                               sucursal                 @relation(fields: [sucursal_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comp_sucursal")
  tipo_comprobante                       tipo_comprobante         @relation(fields: [tipo_comprobante_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comp_tcomp")
  usuario                                usuario                  @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comp_usuario")
  comprobante_comprobante_ref_id_inversa comprobante[]            @relation("comprobante_comprobante_ref_id")
  comprobante_cuota                      comprobante_cuota[]
  comprobante_detalle                    comprobante_detalle[]
  comprobante_pago                       comprobante_pago[]
  lote_sunat_detalle                     lote_sunat_detalle[]
  sunat_envio                            sunat_envio[]

  @@unique([serie_id, numero], map: "uk_comprobante_num")
  @@index([caja_sesion_id], map: "ix_comp_caja")
  @@index([cliente_id], map: "ix_comp_cliente")
  @@index([cliente_num_doc], map: "ix_comp_cliente_doc")
  @@index([descuento_id], map: "ix_comp_desc")
  @@index([estado_sunat, fecha_emision], map: "ix_comp_estado")
  @@index([estancia_id], map: "ix_comp_estancia")
  @@index([sucursal_id, fecha_emision], map: "ix_comp_fecha")
  @@index([moneda_id], map: "ix_comp_moneda")
  @@index([motivo_nota_id], map: "ix_comp_motivo")
  @@index([comprobante_ref_id], map: "ix_comp_ref")
  @@index([reserva_id], map: "ix_comp_reserva")
  @@index([tipo_comprobante_id, fecha_emision], map: "ix_comp_tipo_fecha")
  @@index([usuario_id], map: "ix_comp_usuario")
}

model comprobante_cuota {
  id                BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  comprobante_id    BigInt      @db.UnsignedBigInt
  numero_cuota      Int         @db.UnsignedTinyInt
  monto             Decimal     @db.Decimal(14, 2)
  fecha_vencimiento DateTime    @db.Date
  comprobante       comprobante @relation(fields: [comprobante_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ccuota_comp")

  @@unique([comprobante_id, numero_cuota], map: "uk_ccuota")
}

model comprobante_detalle {
  id                     BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  comprobante_id         BigInt                  @db.UnsignedBigInt
  item                   Int                     @db.UnsignedSmallInt
  producto_id            Int?                    @db.UnsignedInt
  estancia_id            BigInt?                 @db.UnsignedBigInt
  descripcion            String                  @db.VarChar(500)
  unidad_medida_id       Int                     @db.UnsignedSmallInt
  tipo_afectacion_igv_id Int                     @db.UnsignedTinyInt
  cantidad               Decimal                 @db.Decimal(12, 3)
  valor_unitario         Decimal                 @db.Decimal(14, 4)
  precio_unitario        Decimal                 @db.Decimal(14, 4)
  descuento              Decimal                 @default(0.00) @db.Decimal(14, 2)
  valor_venta            Decimal                 @db.Decimal(14, 2)
  igv                    Decimal                 @default(0.00) @db.Decimal(14, 2)
  total                  Decimal                 @db.Decimal(14, 2)
  tipo_afectacion_igv    tipo_afectacion_igv     @relation(fields: [tipo_afectacion_igv_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cdet_afec")
  comprobante            comprobante             @relation(fields: [comprobante_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cdet_comp")
  estancia               estancia?               @relation(fields: [estancia_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cdet_estancia")
  producto               producto?               @relation(fields: [producto_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cdet_producto")
  unidad_medida          unidad_medida           @relation(fields: [unidad_medida_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cdet_um")
  movimiento_inventario  movimiento_inventario[]

  @@unique([comprobante_id, item], map: "uk_cdet_item")
  @@index([tipo_afectacion_igv_id], map: "ix_cdet_afec")
  @@index([estancia_id], map: "ix_cdet_estancia")
  @@index([producto_id], map: "ix_cdet_producto")
  @@index([unidad_medida_id], map: "ix_cdet_um")
}

model comprobante_pago {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  comprobante_id  BigInt            @db.UnsignedBigInt
  metodo_pago_id  Int               @db.UnsignedTinyInt
  monto           Decimal           @db.Decimal(14, 2)
  referencia      String?           @db.VarChar(60)
  fecha_hora      DateTime          @default(now()) @db.DateTime(0)
  comprobante     comprobante       @relation(fields: [comprobante_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cpago_comp")
  metodo_pago     metodo_pago       @relation(fields: [metodo_pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cpago_metodo")
  caja_movimiento caja_movimiento[]

  @@index([comprobante_id], map: "ix_cpago_comp")
  @@index([metodo_pago_id], map: "ix_cpago_metodo")
}

model concepto_movimiento {
  id                    Int                        @id @default(autoincrement()) @db.UnsignedSmallInt
  tipo_movimiento_id    Int                        @db.UnsignedTinyInt
  ambito                concepto_movimiento_ambito
  codigo                String                     @db.VarChar(30)
  descripcion           String                     @db.VarChar(100)
  activo                Boolean                    @default(true) @db.TinyInt
  tipo_movimiento       tipo_movimiento            @relation(fields: [tipo_movimiento_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cmov_tipo")
  caja_movimiento       caja_movimiento[]
  movimiento_inventario movimiento_inventario[]

  @@unique([ambito, codigo], map: "uk_cmov")
  @@index([tipo_movimiento_id], map: "ix_cmov_tipo")
}

model descuento {
  id                    Int            @id @default(autoincrement()) @db.UnsignedInt
  empresa_id            Int            @db.UnsignedInt
  nombre                String         @db.VarChar(80)
  tipo                  descuento_tipo
  valor                 Decimal        @db.Decimal(12, 2)
  monto_minimo          Decimal        @default(0.00) @db.Decimal(14, 2)
  requiere_autorizacion Boolean        @default(false) @db.TinyInt
  vigente_desde         DateTime       @db.Date
  vigente_hasta         DateTime?      @db.Date
