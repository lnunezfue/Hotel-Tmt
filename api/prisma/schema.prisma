  @@index([serie_id], map: "ix_useries_serie")
}

model usuario_sucursal {
  usuario_id   Int      @db.UnsignedInt
  sucursal_id  Int      @db.UnsignedInt
  es_principal Boolean  @default(false) @db.TinyInt
  sucursal     sucursal @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_us_sucursal")
  usuario      usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_us_usuario")

  @@id([usuario_id, sucursal_id])
  @@index([sucursal_id], map: "ix_us_sucursal")
}

