model sucursal {
  id                     Int                     @id @default(autoincrement()) @db.UnsignedInt
  empresa_id             Int                     @db.UnsignedInt
  codigo_establecimiento String                  @default("0000") @db.Char(4)
  nombre                 String                  @db.VarChar(120)
  tipo                   sucursal_tipo           @default(HOTEL)
  direccion              String                  @db.VarChar(250)
  ubigeo_codigo          String                  @db.Char(6)
  telefono               String?                 @db.VarChar(20)
  hora_checkin           DateTime                @default(dbgenerated("'14:00:00'")) @db.Time(0)
  hora_checkout          DateTime                @default(dbgenerated("'12:00:00'")) @db.Time(0)
  activo                 Boolean                 @default(true) @db.TinyInt
  created_at             DateTime                @default(now()) @db.Timestamp(0)
  updated_at             DateTime                @default(now()) @db.Timestamp(0)
  empresa                empresa                 @relation(fields: [empresa_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sucursal_empresa")
  ubigeo                 ubigeo                  @relation(fields: [ubigeo_codigo], references: [codigo], onDelete: NoAction, onUpdate: NoAction, map: "fk_sucursal_ubigeo")
  caja                   caja[]
  compra                 compra[]
  comprobante            comprobante[]
  estancia               estancia[]
  habitacion             habitacion[]
  movimiento_inventario  movimiento_inventario[]
  piso                   piso[]
  producto_stock         producto_stock[]
  reserva                reserva[]
  serie                  serie[]
  tarifa                 tarifa[]
  usuario_sucursal       usuario_sucursal[]

  @@unique([empresa_id, codigo_establecimiento], map: "uk_sucursal_estab")
  @@index([ubigeo_codigo], map: "fk_sucursal_ubigeo")
}

model sunat_envio {
  id               BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  comprobante_id   BigInt?               @db.UnsignedBigInt
  lote_sunat_id    BigInt?               @db.UnsignedBigInt
  operacion        sunat_envio_operacion
  ticket           String?               @db.VarChar(50)
  codigo_respuesta String?               @db.VarChar(10)
  mensaje          String?               @db.VarChar(1000)
  exitoso          Boolean               @default(false) @db.TinyInt
  duracion_ms      Int?                  @db.UnsignedInt
  fecha_hora       DateTime              @default(now()) @db.DateTime(0)
  comprobante      comprobante?          @relation(fields: [comprobante_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_se_comp")
  lote_sunat       lote_sunat?           @relation(fields: [lote_sunat_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_se_lote")

  @@index([comprobante_id, fecha_hora], map: "ix_se_comp")
  @@index([lote_sunat_id], map: "ix_se_lote")
}

model tarifa {
  id                 Int                  @id @default(autoincrement()) @db.UnsignedInt
  sucursal_id        Int                  @db.UnsignedInt
  tipo_habitacion_id Int                  @db.UnsignedInt
  canal_venta_id     Int                  @db.UnsignedSmallInt
  turno_id           Int                  @db.UnsignedTinyInt
  moneda_id          Int                  @db.UnsignedTinyInt
  precio             Decimal              @db.Decimal(14, 2)
  vigente_desde      DateTime             @db.Date
  vigente_hasta      DateTime?            @db.Date
  activo             Boolean              @default(true) @db.TinyInt
  created_at         DateTime             @default(now()) @db.Timestamp(0)
  updated_at         DateTime             @default(now()) @db.Timestamp(0)
  canal_venta        canal_venta          @relation(fields: [canal_venta_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tarifa_canal")
  moneda             moneda               @relation(fields: [moneda_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tarifa_moneda")
  sucursal           sucursal             @relation(fields: [sucursal_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tarifa_sucursal")
  tipo_habitacion    tipo_habitacion      @relation(fields: [tipo_habitacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tarifa_thab")
  turno              turno                @relation(fields: [turno_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tarifa_turno")
  reserva_habitacion reserva_habitacion[]

  @@unique([sucursal_id, tipo_habitacion_id, canal_venta_id, turno_id, vigente_desde], map: "uk_tarifa")
  @@index([moneda_id], map: "fk_tarifa_moneda")
  @@index([sucursal_id, tipo_habitacion_id, canal_venta_id, turno_id, activo, vigente_desde], map: "ix_tarifa_busqueda")
  @@index([canal_venta_id], map: "ix_tarifa_canal")
  @@index([tipo_habitacion_id], map: "ix_tarifa_tipo")
  @@index([turno_id], map: "ix_tarifa_turno")
}

