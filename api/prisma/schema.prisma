  rol        rol     @relation(fields: [rol_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rp_rol")

  @@id([rol_id, permiso_id])
  @@index([permiso_id], map: "ix_rp_permiso")
}

model serie {
  id                  Int              @id @default(autoincrement()) @db.UnsignedInt
  sucursal_id         Int              @db.UnsignedInt
  tipo_comprobante_id Int              @db.UnsignedTinyInt
