  correlativo_actual  Int              @default(0) @db.UnsignedInt
  es_contingencia     Boolean          @default(false) @db.TinyInt
  activo              Boolean          @default(true) @db.TinyInt
  sucursal            sucursal         @relation(fields: [sucursal_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_serie_sucursal")
  tipo_comprobante    tipo_comprobante @relation(fields: [tipo_comprobante_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_serie_tcomp")
