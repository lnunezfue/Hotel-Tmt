  movimiento_inventario        movimiento_inventario[]
  reserva                      reserva[]
  usuario_serie                usuario_serie[]
  usuario_sucursal             usuario_sucursal[]

  @@unique([empresa_id, username], map: "uk_usuario_username")
  @@index([rol_id], map: "ix_usuario_rol")
}

model usuario_serie {
  usuario_id Int     @db.UnsignedInt
