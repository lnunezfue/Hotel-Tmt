model reserva_habitacion {
  id              BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  reserva_id      BigInt                    @db.UnsignedBigInt
  habitacion_id   Int                       @db.UnsignedInt
  tarifa_id       Int?                      @db.UnsignedInt
  turno_id        Int                       @db.UnsignedTinyInt
  fecha_entrada   DateTime                  @db.DateTime(0)
  fecha_salida    DateTime                  @db.DateTime(0)
  cantidad_turnos Int                       @default(1) @db.UnsignedSmallInt
  precio_unitario Decimal                   @db.Decimal(14, 2)
  subtotal        Decimal?                  @db.Decimal(14, 2) /// columna generada por la BD (solo lectura)
  estado          reserva_habitacion_estado @default(ACTIVA)
  habitacion      habitacion                @relation(fields: [habitacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rh_hab")
  reserva         reserva                   @relation(fields: [reserva_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rh_reserva")
  tarifa          tarifa?                   @relation(fields: [tarifa_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rh_tarifa")
  turno           turno                     @relation(fields: [turno_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rh_turno")
  estancia        estancia[]

  @@index([habitacion_id, fecha_entrada, fecha_salida], map: "ix_rh_hab_fechas")
  @@index([reserva_id], map: "ix_rh_reserva")
  @@index([tarifa_id], map: "ix_rh_tarifa")
  @@index([turno_id], map: "ix_rh_turno")
}

model rol {
