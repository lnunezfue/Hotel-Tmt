model usuario {
  id                           Int                           @id @default(autoincrement()) @db.UnsignedInt
  empresa_id                   Int                           @db.UnsignedInt
  rol_id                       Int                           @db.UnsignedSmallInt
  username                     String                        @db.VarChar(50)
  password_hash                String                        @db.VarChar(255)
  nombres                      String                        @db.VarChar(100)
  apellidos                    String                        @db.VarChar(100)
  email                        String?                       @db.VarChar(120)
  ultimo_acceso                DateTime?                     @db.DateTime(0)
  intentos_fallidos            Int                           @default(0) @db.UnsignedTinyInt
  activo                       Boolean                       @default(true) @db.TinyInt
  created_at                   DateTime                      @default(now()) @db.Timestamp(0)
  updated_at                   DateTime                      @default(now()) @db.Timestamp(0)
  empresa                      empresa                       @relation(fields: [empresa_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario_empresa")
  rol                          rol                           @relation(fields: [rol_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario_rol")
  auditoria                    auditoria[]
  caja_movimiento              caja_movimiento[]
  caja_sesion                  caja_sesion[]
  compra                       compra[]
  comprobante                  comprobante[]
  estancia_usuario_checkin_id  estancia[]                    @relation("estancia_usuario_checkin_id")
